                {
                    "name": "获取会话消息",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/api/chat-sessions/1/messages",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "chat-sessions",
                                "1",
                                "messages"
