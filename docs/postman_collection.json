        {
            "name": "空间分析",
            "description": "土地转移矩阵和动态度分析接口",
            "item": [
                {
                    "name": "获取转移矩阵时间周期",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/api/analysis/transfer-matrix/periods",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "analysis",
                                "transfer-matrix",
                                "periods"
                            ]
                        },
                        "description": "获取可用于查询转移矩阵的时间周期列表。\n\n**返回示例**：[\"1990-2000\", \"2000-2010\", \"2010-2020\", \"2020-2023\"]"
                    }
                },
                {
                    "name": "获取土地转移矩阵",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/api/analysis/transfer-matrix/2010-2020",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "analysis",
                                "transfer-matrix",
                                "2010-2020"
                            ]
                        },
                        "description": "获取指定时间段的土地利用转移矩阵。\n\n**返回内容**：\n- absoluteMatrix: 绝对量转移矩阵\n- percentageMatrix: 百分比转移矩阵\n- landTypes: 地类名称数组"
                    }
                },
                {
                    "name": "获取大屏看板数据（综合动态度）",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/api/analysis/dashboard/2023?type=comprehensive",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "analysis",
                                "dashboard",
                                "2023"
                            ],
                            "query": [
                                {
                                    "key": "type",
                                    "value": "comprehensive"
                                }
                            ]
                        },
                        "description": "获取大屏看板数据，包含省份汇总、动态度排行榜和预警信息。\n\n**动态度类型**：\n- comprehensive: 综合动态度（默认）\n- cropland: 耕地动态度\n- forest: 林地动态度\n- grassland: 草地动态度\n- impervious: 建设用地动态度\n- water: 水体动态度"
                    }
                },
                {
                    "name": "获取大屏看板数据（耕地动态度）",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/api/analysis/dashboard/2023?type=cropland",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "analysis",
                                "dashboard",
                                "2023"
                            ],
                            "query": [
                                {
                                    "key": "type",
                                    "value": "cropland"
                                }
                            ]
                        },
                        "description": "获取耕地单一土地利用动态度数据。"
                    }
                }
            ]
        },
        {
            "name": "气象服务",
            "description": "天气实况和预报查询（代理高德天气 API）",
            "item": [
                {
                    "name": "获取实时天气",
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/api/weather?city=530100&extensions=base",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "weather"
                            ],
                            "query": [
                                {
                                    "key": "city",
                                    "value": "530100",
                                    "description": "城市行政区划代码（530100 = 昆明市）"
                                },
                                {
                                    "key": "extensions",
                                    "value": "base",
                                    "description": "base = 实况天气"
                                }
                            ]
                        },
                        "description": "获取指定城市的实时天气数据。\n\n**常用城市代码**：\n- 昆明市: 530100\n- 曲靖市: 530300\n- 玉溪市: 530400"
                    }
                },
                {
                    "name": "获取天气预报",
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/api/weather?city=530100&extensions=all",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "weather"
                            ],
                            "query": [
                                {
                                    "key": "city",
                                    "value": "530100"
                                },
                                {
                                    "key": "extensions",
                                    "value": "all",
                                    "description": "all = 天气预报"
                                }
                            ]
                        },
                        "description": "获取指定城市的天气预报数据（未来几天）。"
                    }
                }
            ]
        },
        {
            "name": "智能分析",
            "description": "AI 驱动的数据分析接口",
            "item": [
                {
                    "name": "AI 流式分析",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"分析云南省近40年耕地面积变化趋势\" }\n  ],\n  \"year\": 2023,\n  \"componentContext\": { \"type\": \"province_trend\" },\n  \"model\": \"gpt-oss:20b\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/ai/analyze-stream",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "ai",
                                "analyze-stream"
                            ]
                        },
                        "description": "AI 智能分析接口，返回 SSE 流式响应。\n\n**参数说明**：\n- messages: 对话消息数组\n- year: 分析年份（默认 2023）\n- componentContext.type: 上下文类型\n  - province_trend: 省级趋势\n  - prefecture_pie: 地级市饼图\n  - county_pie: 区县饼图\n- model: AI 模型\n  - gpt-oss:20b (默认)\n  - deepseek-r1:8b\n  - gemma3:4b\n  - deepseek-r1:1.5b"
                    }
                },
                {
                    "name": "获取建议问题",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/api/ai/suggestions",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "ai",
                                "suggestions"
                            ]
                        },
                        "description": "获取预设的 AI 分析建议问题列表。"
                    }
                }
            ]
        },
