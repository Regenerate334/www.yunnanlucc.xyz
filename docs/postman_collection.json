{
    "info": {
        "name": "云南省国土空间规划平台 API",
        "description": "云南省国土空间规划监测预警系统后端接口测试集合。\n\n## 使用说明\n1. 先执行「用户登录」接口获取令牌\n2. 令牌会自动保存到环境变量\n3. 后续接口会自动使用保存的令牌\n\n## 数据说明\n- 土地利用数据来源：中国土地覆盖数据集 (CLCD)\n- 时间跨度：1985-2023年\n- 地类数量：9种",
        "version": "1.0.0",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{token}}",
                "type": "string"
            }
        ]
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3000",
            "type": "string"
        },
        {
            "key": "token",
            "value": "",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "用户认证",
            "description": "用户登录、注册和令牌验证相关接口",
            "item": [
                {
                    "name": "用户登录",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    var jsonData = pm.response.json();",
                                    "    if (jsonData.token) {",
                                    "        pm.collectionVariables.set('token', jsonData.token);",
                                    "        console.log('令牌已自动保存');",
                                    "    }",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"123456\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/auth/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "login"
                            ]
                        },
                        "description": "用户登录接口。验证用户名和密码，成功后返回 JWT 令牌。\n\n**注意**：令牌会自动保存到集合变量中，后续请求会自动携带。"
                    }
                },
                {
                    "name": "用户注册",
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"username\": \"newuser\",\n  \"password\": \"password123\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/auth/register",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "register"
                            ]
                        },
                        "description": "用户注册接口。\n\n**验证规则**：\n- 用户名：至少 3 个字符\n- 密码：至少 6 个字符"
                    }
                },
                {
                    "name": "验证令牌",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/api/auth/verify",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "verify"
                            ]
                        },
                        "description": "验证当前令牌是否有效，返回解码后的用户信息。"
                    }
                }
            ]
        },
        {
            "name": "土地利用数据",
            "description": "CLCD 土地利用覆盖数据查询接口",
            "item": [
                {
                    "name": "获取可用年份列表",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/api/clcd/years",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "clcd",
                                "years"
                            ]
                        },
                        "description": "获取数据集中所有可用年份。\n\n**返回示例**：[1985, 1990, 1995, 2000, 2005, 2010, 2015, 2020, 2023]"
                    }
                },
                {
                    "name": "获取年份汇总数据",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/api/clcd/2023/summary",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "clcd",
                                "2023",
                                "summary"
                            ]
                        },
                        "description": "获取指定年份各土地利用类型的面积汇总。\n\n**路径参数**：year - 目标年份（如 2023）"
                    }
                },
                {
                    "name": "获取省级时序数据",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/api/clcd/province",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "clcd",
                                "province"
                            ]
                        },
                        "description": "获取云南省所有年份的土地利用数据（宽表格式）。\n\n**注意**：面积单位为平方米 (m²)"
                    }
                },
                {
                    "name": "获取所有地级市数据",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/api/clcd/prefecture",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "clcd",
                                "prefecture"
                            ]
                        },
                        "description": "获取云南省 16 个地级市（州）的全量土地利用数据。"
                    }
                },
                {
                    "name": "获取所有区县数据",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/api/clcd/county",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "clcd",
                                "county"
                            ]
                        },
                        "description": "获取云南省所有区县的全量土地利用数据。"
                    }
                },
                {
                    "name": "获取地级市趋势数据",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/api/clcd/trend/prefecture/昆明市",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "clcd",
                                "trend",
                                "prefecture",
                                "昆明市"
                            ]
                        },
                        "description": "获取指定地级市的历史变化趋势数据。\n\n**路径参数**：\n- level: prefecture（地级市）\n- name: 区域名称（如：昆明市）"
                    }
                },
                {
                    "name": "获取区县趋势数据",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/api/clcd/trend/county/官渡区",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "clcd",
                                "trend",
                                "county",
                                "官渡区"
                            ]
                        },
                        "description": "获取指定区县的历史变化趋势数据。\n\n**路径参数**：\n- level: county（区县）\n- name: 区域名称（如：官渡区）"
                    }
                },
                {
                    "name": "获取指定地级市时序数据",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/api/clcd/prefecture/name/昆明市",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "clcd",
                                "prefecture",
                                "name",
                                "昆明市"
                            ]
                        },
                        "description": "获取指定地级市的所有年份时序数据。"
                    }
                },
                {
                    "name": "获取指定区县时序数据",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/api/clcd/county/name/官渡区",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "clcd",
                                "county",
                                "name",
                                "官渡区"
                            ]
                        },
                        "description": "获取指定区县的所有年份时序数据。"
                    }
                },
                {
                    "name": "获取地级市下属区县数据",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/api/clcd/county/prefecture/昆明市",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "clcd",
                                "county",
                                "prefecture",
                                "昆明市"
                            ]
                        },
                        "description": "获取某地级市所有下属区县的土地利用数据。"
                    }
                },
                {
                    "name": "获取指定年份所有地级市数据",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/api/clcd/prefecture/year/2023",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "clcd",
                                "prefecture",
                                "year",
                                "2023"
                            ]
                        },
                        "description": "获取指定年份所有地级市的数据。"
                    }
                },
                {
                    "name": "获取指定年份所有区县数据",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/api/clcd/county/year/2023",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "clcd",
                                "county",
                                "year",
                                "2023"
                            ]
                        },
                        "description": "获取指定年份所有区县的数据。"
                    }
                }
            ]
        },
        {
            "name": "行政区划",
