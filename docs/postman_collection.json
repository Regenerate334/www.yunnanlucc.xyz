                },
                {
                    "name": "添加消息",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"role\": \"user\",\n  \"content\": \"分析云南省的林地变化\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/chat-sessions/1/messages",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "chat-sessions",
                                "1",
                                "messages"
                            ]
                        },
                        "description": "向会话添加新消息。\n\n**参数**：\n- role: user 或 assistant\n- content: 消息内容\n\n**注意**：如果是首条用户消息且标题为\"新对话\"，系统会自动生成智能标题。"
                    }
                }
            ]
        },
