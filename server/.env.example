# 后端服务配置
PORT=3000
LOG_LEVEL=info

# 数据库配置
DB_USER=postgres
DB_HOST=localhost
DB_DATABASE=yunnan_CLCD
DB_PASSWORD=your_password
DB_PORT=5432

# AI 服务配置 (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b
# 报告生成专用模型（推荐使用大参数模型，格式遵循能力更强）
# 若不配置，默认使用 OLLAMA_MODEL
REPORT_MODEL=gpt-oss:120b-cloud
DEEPSEEK_API_KEY=your_deepseek_api_key

# 第三方服务配置
AMAP_WEATHER_KEY=your_amap_key

# JWT 配置
JWT_SECRET=your_jwt_secret_key_here
