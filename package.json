{
  "name": "my_webgis_project",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"green,blue\" \"npm run server\" \"npm run client\"",
    "start:all": "pm2 start ecosystem.config.cjs",
    "restart:all": "pm2 restart ecosystem.config.cjs",
    "stop:all": "pm2 delete ollama nginx tunnel postgres geoserver ai-service",
    "status": "pm2 status",
    "client": "vite",
    "server": "node ./server/index.js",
    "build": "vite build",
    "init:db": "node ./ops/data/initDb.js",
    "sync:rate-layers": "node ./ops/data/sync_rate_layers.js",
    "sync:sld": "node ./ops/geo/sync_all_slds.js"
  },
  "dependencies": {
    "@turf/bbox": "^7.3.4",
    "@turf/turf": "^7.2.0",
    "@types/turf": "^3.5.32",
    "bcryptjs": "^3.0.3",
    "cesium": "^1.130.0",
    "cesium-navigation-es6": "^3.0.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "echarts": "^5.5.0",
    "echarts-gl": "^2.0.9",
    "express": "^4.19.2",
    "express-rate-limit": "^8.3.2",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "highlight.js": "^11.11.1",
    "jsonwebtoken": "^9.0.3",
    "katex": "^0.16.27",
    "markdown-it": "^14.1.0",
    "markdown-it-texmath": "^1.0.0",
    "ollama": "^0.6.3",
    "pg": "^8.11.5",
    "pinia": "^2.2.4",
    "puppeteer": "^24.38.0",
    "vite-plugin-cesium": "^1.2.23",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@vitejs/plugin-vue": "^5.2.3",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.13",
    "vite": "^6.3.5",
    "vite-plugin-compression": "^0.5.1"
  }
}