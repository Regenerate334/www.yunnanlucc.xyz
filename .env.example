# WebGIS 统一环境变量模板 (Unified Environment Template)
# 请复制此文件为 .env 并填写实际值。部分变量对开发环境和生产环境均有效。

# --- 前端配置 (Vite) ---
# 天地图 API Token (https://console.tianditu.gov.cn/)
VITE_TIANDITU_TOKEN=your_tianditu_token_here
VITE_API_BASE_URL=/api

# --- 后端基础配置 ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
LOG_FILE_LEVEL=info

# --- 数据库配置 (Postgres) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=webgis_app_user
DB_PASSWORD=your_db_password_here
DB_DATABASE=yunnan_CLCD

# 兼容性变量 (部分旧组件可能使用 PG 前缀)
PGHOST=localhost
PGPORT=5432
PGUSER=webgis_app_user
PGPASSWORD=your_db_password_here
PGDATABASE=yunnan_CLCD

# --- GeoServer 配置 ---
GEOSERVER_USER=admin
GEOSERVER_PASSWORD=your_geoserver_password_here

# --- AI & LLM 配置 ---
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=deepseek-v4-flash
REPORT_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# --- 内部 API 调用 (用于工具链内部回调到受鉴权的 /api/analysis 路由) ---
# 填写一个有效用户的 JWT（Authorization: Bearer <token>），供 server/utils/tools/* 内部 fetch 使用。
INTERNAL_API_TOKEN=your_jwt_token_here

# --- 安全与认证 ---
JWT_SECRET=your_long_random_jwt_secret_here
DEFAULT_ADMIN_PASSWORD=admin123456@
GLOBAL_HOTSWAP_SECRET=your_ultra_secure_hotswap_secret_here
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# --- 第三方 API ---
AMAP_WEATHER_KEY=your_amap_weather_key_here
